{
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/catalog/(men|women)\\.md", "dest": "/api/ai-catalog?list=$1" },
    { "src": "/catalog/football-jerseys\\.md", "dest": "/api/ai-catalog?list=jerseys" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/women", "dest": "/women.html" },
    { "src": "/reviews", "dest": "/reviews.html" },
    { "src": "/faq", "dest": "/faq.html" },
    { "src": "/how-to-order", "dest": "/how-to-order.html" },
    { "src": "/legal", "dest": "/legal.html" },
    { "src": "/women/([^/]+)", "dest": "/women.html" },
    { "src": "/reviews/([^/]+)", "dest": "/reviews.html" },
    { "src": "/faq/([^/]+)", "dest": "/faq.html" },
    { "src": "/how-to-order/([^/]+)", "dest": "/how-to-order.html" },
    { "src": "/legal/([^/]+)", "dest": "/legal.html" },
    { "src": "/([^/.]+)", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
